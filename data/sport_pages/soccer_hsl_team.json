 "capabilities": {
  "source": "hslteam",
  "skills": [
   {
    "id": "stays_up",
    "group": "phys",
    "name": "Stays on its feet in play",
    "real": "In the team format each T1 runs its own program; a robot on the ground leaves the team a player short. The HSL lists dynamic walking as a core problem.",
    "measure": "the match record: own falls / (3 robots × play minutes). Gate: ≥ 2 robots walking (scenario_trace: travel while upright ≥ 8 m a minute).",
    "line": "≤ 0.3 per robot-minute in 2/3 of matches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "push",
    "group": "phys",
    "name": "Stays up when pushed",
    "real": "Body contact is common in 3 v 3 (pushing has a legal limit); a robot still standing after a knock can keep playing the ball.",
    "measure": "Scenario push: every 15 s of play each standing own robot gets 0.8 m/s sideways at its trunk (alternating); share not down within 3 s (scenario_trace down).",
    "line": "Up after ≥ 2/3 of the pushes",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "walks",
    "group": "phys",
    "name": "Walks in play",
    "real": "Positioning and turning come before any action; every seat has to make its own robot walk.",
    "measure": "scenario_trace (a row every 0.1 s): each robot's travel while upright in live play, metres per minute.",
    "line": "≥ 2 robots at ≥ 8 m per minute in 2/3 of matches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "gets_up",
    "group": "phys",
    "name": "Gets up after a fall",
    "real": "The HSL requires robots to get up alone; 20 s without an attempt means removal. The real T1 gets up in 2.7-2.9 s. Every seat writes its own get-up.",
    "measure": "Scenario getup: at 8, 38 and 68 s of play every own robot on the pitch is laid down in the rules' standard supine pose (≥ 1.2 m from the ball); time until it stands ≥ 1 s (scenario_trace up). Match: the match record / falls (pooled, ≥ 3 falls).",
    "line": "Scenario: up within 20 s after ≥ 2/3 of the lay-downs; match ≥ 80 %",
    "secondary": false,
    "three_checks": true
   },
   {
    "id": "no_sendoff",
    "group": "phys",
    "name": "Not sent off for staying down",
    "real": "No get-up attempt within 20 s means removal; one robot fewer matters a lot in 3 v 3.",
    "measure": "the match record (team); in scenario getup the robots removed after a lay-down (scenario_trace bench). Gate: ≥ 3 falls or lay-downs.",
    "line": "No removal in 2/3 of matches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "ball_view",
    "group": "phys",
    "name": "Keeps the ball in its head camera",
    "real": "In the team format each robot sees only its own head camera (480 × 360, 80 deg); a robot that does not see the ball depends on its teammates' messages.",
    "measure": "scenario_trace view: the ball inside the robot's head camera frustum; mean share over robots on the pitch in live play.",
    "line": "≥ 0.5 in 2/3 of matches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "reaches_ball",
    "group": "comp",
    "name": "Gets to the ball first",
    "real": "Possession starts with getting there first; seeing, walking over and touching is the whole chain from perception to action.",
    "measure": "Scenarios loose / counter: share of released balls whose first touch is own (scenario_trace lt = last toucher). Match: the match record",
    "line": "Scenario: first touch in ≥ 1/2; match ≥ 20 touches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "react",
    "group": "phys",
    "name": "Starts quickly towards a loose ball",
    "real": "Whoever starts first after a kick gets there first. Real teams shorten the start with visual reaction.",
    "measure": "Scenario loose: at 5, 25, 45 and 65 s a ball is rolled at 2 m/s from beside the centre circle into the own half; time until the own robot nearest at release moves towards it at > 0.3 m/s.",
    "line": "Moves within 1 s for ≥ 2/3 of the balls",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "loop",
    "group": "eng",
    "name": "Every robot's control loop keeps running",
    "real": "Joint-level control needs a row every 20 ms; a seat that stalls makes its robot wobble or fall.",
    "measure": "cmd rows of the match log (each seat's steps): p99 of the gap between commands in live play, worst seat. Gate: it walks.",
    "line": "Worst seat p99 ≤ 3 steps (60 ms) in 2/3 of matches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "spreads",
    "group": "comp",
    "name": "Does not swarm",
    "real": "Champion 3 v 3 teams split roles: one presses, one supports, one guards. Three robots chasing together leave the goal open.",
    "measure": "scenario_trace: share of live play with ≥ 2 own robots within 1.5 m of the ball. Gate: ≥ 2 robots walking.",
    "line": "≤ 20 % in 2/3 of matches",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "keeps_goal",
    "group": "comp",
    "name": "Covers the goal",
    "real": "Someone in front of goal when the ball comes into the own half is the most direct result of a division of roles.",
