    "measure": "Scenario shot: field goals made / attempted, seeds pooled; Checkpoint Evaluation: field goals made / attempted.",
    "line": "≥ 20 % (pooled, ≥ 5 shots)",
    "secondary": false,
    "three_checks": false
   },
