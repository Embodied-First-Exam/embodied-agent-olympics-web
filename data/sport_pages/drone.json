 "capabilities": {
  "source": "g5-drone",
  "skills": [
   {
    "id": "gate1",
    "group": "phys",
    "name": "Takes off and passes gate 1",
    "real": "Arm, lift off, settle and line up on the first gate. Gate 1's position is in /spec; everything after depends on it.",
    "measure": "Checkpoint Evaluation: flights with a gate passed / all flights (pooled per checkpoint, ≥ 4 flights).",
    "line": "≥ 80 % of flights",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "in_control",
    "group": "phys",
    "name": "Stays in control in flight",
    "real": "Flying on top of a Betaflight-like rate loop with latency and wind: no hit on a frame, wall or floor, no crossing of the safety line.",
    "measure": "Checkpoint Evaluation: of the flights past gate 1, the share that end finished (or only by a shutter hit, which is the shutter skill's); a frame hit, out of bounds, the time limit or the failsafe counts as out of control.",
    "line": "≥ 70 % of flights past gate 1 (≥ 4)",
    "secondary": false,
    "three_checks": true
   },
   {
    "id": "gust",
    "group": "phys",
    "name": "Recovers from a gust",
    "real": "Air moves indoors too and gusts are stronger outdoors. A gust acts through the drag, the IMU feels it and the gates drift in the image: the drone must pull back onto its line quickly.",
    "measure": "Scenario gust: the official start; 0.4 s after gate 2 the world's gust state gets 5 m/s across the drone's velocity (alternating sides, then decaying with the world's 1.2 s time constant); the round ends at gate 5. Of the gusted rounds, the share reaching gate 5.",
    "line": "≥ 2/3 of gusted rounds (≥ 3)",
    "secondary": false,
    "three_checks": true
   },
   {
    "id": "loop",
    "group": "eng",
    "name": "A fast control loop",
    "real": "Research racers fly at the throttle + body-rate level with about 40 ms end to end; a slow loop falls behind in turns and gates.",
    "measure": "Checkpoint Evaluation: 90th-percentile command latency (the step a command takes effect less the step of the state the program had seen); gate: ≥ 100 applied commands in the unit.",
    "line": "p90 ≤ 2 steps (20 ms) in ≥ 2/3 of units",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "lap1",
    "group": "phys",
    "name": "Finds the gates for a lap",
    "real": "Only gate 1 is given; the others are found, numbered and mapped from the 320 × 240 FPV image while gate sightings correct the IMU's drift.",
    "measure": "Checkpoint Evaluation: flights completing lap 1 in order (progress ≥ 1/3 or finished) / all flights.",
    "line": "≥ 70 % of flights",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "relocalize",
    "group": "phys",
    "name": "Finds the gates ahead from a mid-course start",
    "real": "In a real race a drifted estimate is recovered from gate sightings. Here the drone starts mid-course before the hardest section: only the camera can tell which gates lie ahead.",
    "measure": "Scenario mid: each round the drone hovers 5 m before gate K facing it (K = the start of the shutter-free 3-gate section with the most turn + climb; the referee's count starts at K - 1, next_gate = K; the /spec start fields report this start); the round ends after K, K+1, K+2. The share of rounds completing the section.",
    "line": "≥ 2/3 of rounds (≥ 3)",
    "secondary": false,
    "three_checks": false
   },
   {
    "id": "centred",
    "group": "phys",
    "name": "Threads the gates near the centre",
    "real": "With a good map and self-localization the drone passes near the opening's centre; near the edge it clips the frame.",
    "measure": "replay: distance from the opening's centre at each pass, median per unit (≥ 3 passes).",
    "line": "≤ 0.3 m (shown only)",
    "secondary": true,
    "three_checks": false
   },
   {
    "id": "shutters",
    "group": "phys",
    "name": "Times the moving shutters",
    "real": "A shutter slides sinusoidally across its gate; the camera shows only where it is now: the program infers period and phase from images and slows or waits before crossing.",
    "measure": "Checkpoint Evaluation: of the flights past gate 2, the share through shutter gate 3 (not ended by a shutter hit). Scenario shutter: starts 5 m before the shutter gate with the shutter's phase pinned to block the gate centre 1.5 s after the start (when a drone flying straight in arrives); the share of rounds through the shutter gate and the shutter hits.",
    "line": "Checkpoint Evaluation ≥ 80 % (≥ 4); scenario ≥ 2/3 of rounds",
    "secondary": false,
    "three_checks": true
   },
   {
    "id": "pace",
    "group": "comp",
    "name": "Flies at pace",
    "real": "Racing is the fastest line that still does not crash: too slow loses, too fast hits a frame.",
    "measure": "Checkpoint Evaluation: mean speed of finished flights = 3 × lap length / finish time, per unit; ≥ 2/3 of the units with a finish.",
    "line": "≥ 3.4 m/s",
    "secondary": false,
    "three_checks": true
   },
   {
    "id": "finishes",
    "group": "comp",
    "name": "Finishes the race (composite)",
    "real": "Three full laps: finding gates, flight control, shutters and pace all have to work.",
    "measure": "Checkpoint Evaluation: finished flights / all flights.",
    "line": "≥ 60 % (composite, shown; the old ≥ 90 % fails the reference too: 0.75)",
    "secondary": true,
    "three_checks": true
   }
